{
  "name": "sneakerfeature",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "sh -c \"! grep -rEn '(text|bg|border|ring)-(red|rose|emerald|green)-[0-9]{3}' components app --include=*.tsx\"",
    "cap:sync": "cap sync",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:android": "cap sync android && cap open android",
    "cap:assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#ffffff' --iconBackgroundColorDark '#0a0a0a' --splashBackgroundColor '#0a0a0a' --splashBackgroundColorDark '#0a0a0a' && npm run splash:build",
    "splash:build": "node scripts/build-splash.mjs",
    "images:nobg": "tsx scripts/remove-backgrounds.mts",
    "gift:pro-all": "tsx scripts/grant-pro-all.mts",
    "test:deep-link": "tsx scripts/test-deep-link.mts",
    "test:widgets": "tsx scripts/test-widget-snapshot.mts",
    "test:outreach-rules": "tsx scripts/test-outreach-rules.mts",
    "test:outreach-rls": "tsx scripts/test-outreach-rls.mts",
    "test:account-permissions": "tsx scripts/test-account-permissions.mts",
    "test:scoring": "tsx scripts/test-scoring.mts",
    "test:recommendations": "tsx scripts/test-recommendation-evidence.mts",
    "test:catalog": "tsx scripts/test-catalog-quality.mts",
    "test:ai-reservations": "tsx scripts/test-ai-reservations.mts",
    "test:rating-summary": "tsx scripts/test-rating-summary.mts",
    "test:product-boundaries": "tsx scripts/test-product-boundaries.mts",
    "test:core": "npm run test:deep-link && npm run test:widgets && npm run test:outreach-rules && npm run test:account-permissions && npm run test:scoring && npm run test:recommendations && npm run test:catalog && npm run test:ai-reservations && npm run test:rating-summary && npm run test:product-boundaries && npm run test:credits",
    "test:credits": "tsx scripts/test-credit-functions.mts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@imgly/background-removal": "^1.6.0",
    "@next/bundle-analyzer": "^16.2.9",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.10.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "geist": "^1.7.2",
    "live-widgets": "file:live-widgets",
    "lucide-react": "^0.468.0",
    "modern-screenshot": "^4.7.0",
    "native-chrome": "file:native-chrome",
    "next": "15.5.27",
    "openai": "^4.80.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "$postcss",
    "tar": "7.5.22",
    "postcss-selector-parser": "7.1.6",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
