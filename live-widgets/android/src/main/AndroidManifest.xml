<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Merged into the host app manifest by the Gradle manifest merger, so the
         widget and its receiver need no hand-editing of android/app/src/main.

         POST_NOTIFICATIONS is Android 13+. It is only needed for the ongoing
         court-timer notification; the app never requests it at launch (push is
         disabled on Android — see MOBILE.md §6), and CourtSessionNotifier checks
         areNotificationsEnabled() before posting, so an ungranted permission
         costs the notification and nothing else. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- 战靴里程 home-screen widget. -->
        <receiver
            android:name="com.sneakerfeature.livewidgets.ClosetWidgetProvider"
            android:label="@string/sf_widget_closet_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sf_closet_widget_info" />
        </receiver>

        <!-- 结束 on the ongoing notification. Not exported: the only sender is
             our own PendingIntent, which carries our package. -->
        <receiver
            android:name="com.sneakerfeature.livewidgets.CourtSessionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sneakerfeature.livewidgets.END_SESSION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
