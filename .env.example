NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SerpApi image search — powers the admin "Find image" action and the bulk
# image import tool on /admin settings. ALL THREE vars below are REQUIRED for
# those features; when any is missing the import endpoints return
# 500 "Search/import environment variables are incomplete." and bulk jobs
# cannot process any items. Get a key at https://serpapi.com.
SERP_API_PROVIDER=serpapi
SERP_API_KEY=
SERP_API_ENGINE=google_images
# Optional endpoint override (default https://serpapi.com/search.json):
# SERP_API_BASE_URL=
OPENAI_API_KEY=
# Smart Picker (AI shoe recommendation) — packyapi.com, OpenAI-compatible.
# The API key is the real secret key value (NOT the token name "sneakerfeature").
# Base URL: the OpenAI-compatible base, e.g. https://www.packyapi.com/v1
# (give just the host and the app appends /v1 automatically).
# Both naming conventions are accepted: PACKYAPI_* or PACKY_API_*.
PACKYAPI_API_KEY=
PACKYAPI_BASE_URL=https://www.packyapi.com/v1
PACKYAPI_MODEL=claude-haiku-4-5-20251001
# Foot Scan tool (/foot-scan) — REQUIRES its own packyapi key authorised for the
# vision model below. The endpoint is hardcoded to https://www.packyapi.com/v1.
# Remember to Redeploy after changing either of these.
FOOT_SCAN_API_KEY=
# Vision model used by the foot scan. Must be an EXACT model string your
# FOOT_SCAN_API_KEY is authorised to call. Defaults to claude-haiku-4-5-20251001.
FOOT_SCAN_MODEL=
# Optional: self-consistency for the foot scan. The model is read this many times
# in parallel and the results are aggregated (median ratio, majority vote), which
# cuts single-read noise. Default 3 (1 disables it). Cost scales with this number.
FOOT_SCAN_SAMPLES=3
# Optional: sampling temperature used only when FOOT_SCAN_SAMPLES > 1, to give the
# reads enough variety to average. Default 0.5. If your model/relay rejects
# `temperature`, the call auto-retries without it.
FOOT_SCAN_TEMPERATURE=0.5
# Bocha (博查) Web Search — lets the AI fetch general knowledge (injury recovery
# principles, position-specific play tips, term explanations) when the catalog
# doesn't cover the user's question. Register at https://open.bochaai.com
# (supports 支付宝/微信 payment). Leave blank to disable web search; the AI
# falls back to catalog-only behavior, identical to before this feature.
BOCHA_API_KEY=
# --- Local blogger-review pipeline (scripts/blogger-reviews/*) ---------------
# Reuses the vars above: NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# PACKYAPI_API_KEY/PACKYAPI_BASE_URL/PACKYAPI_MODEL. The scripts read .env.local
# (then .env) — they do NOT run on the server. (Link-finding uses yt-dlp's own
# bilisearch/ytsearch, so no Bocha key is needed for the pipeline.)
# External CLIs the ingest script shells out to (install separately, NOT npm):
#   yt-dlp  (search + YouTube subtitles + uploader)  https://github.com/yt-dlp/yt-dlp
#   BBDown  (Bilibili subtitles)                     https://github.com/nilaoda/BBDown
#   ffmpeg  (required by BBDown and by yt-dlp subtitle conversion)
# YouTube blocks anonymous yt-dlp; set ONE of these to enable YouTube (you must
# be logged into YouTube in that browser). Bilibili works without them.
# YTDLP_COOKIES_FROM_BROWSER=firefox   (or chrome/safari/edge/brave)
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt
# Optional override for the subtitle scratch dir (default /tmp/bloggerrev):
# BLOGGER_REVIEWS_TMP_DIR=/tmp/bloggerrev
# Cloudflare Turnstile human verification (login / signup / register / forgot-
# password / admin login / comments / submissions). REQUIRED in production —
# without TURNSTILE_SECRET_KEY the server-side check is skipped (demo mode) and
# the signup endpoint can be mass-abused by bots. Create a free widget at
# https://dash.cloudflare.com/?to=/:account/turnstile and paste both keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Auth "Send Email" hook (OPTIONAL) — route auth emails through Resend's HTTP API
# instead of Supabase SMTP for a faster, more reliable send. Only needed if you
# enable the hook in Supabase. See docs/send-email-hook.md.
# Secret generated by Supabase when you create the hook (format: v1,whsec_...).
SEND_EMAIL_HOOK_SECRET=
RESEND_API_KEY=
# Sender shown on auth emails (must be a verified domain/sender in Resend).
EMAIL_FROM="sneakerfeature <noreply@snkrfeature.com>"
# --- Local background-removal batch (scripts/remove-backgrounds.mts) ----------
# Reuses NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above. Runs OFFLINE
# on your machine (npm run images:nobg), never on the server. Needs rembg on PATH
# (pip install "rembg[cli]" onnxruntime) and `npm install` (sharp). See
# docs/background-removal.md. Optional overrides:
# SUPABASE_STORAGE_BUCKET=shoe-images
# REMBG_MODEL=u2net   (try isnet-general-use or birefnet-general for tougher cuts)
# --- Scheduled jobs / misc server env ----------------------------------------
# REQUIRED for the weekly-digest cron (vercel.json crons → /api/cron/weekly-digest).
# Vercel automatically sends `Authorization: Bearer $CRON_SECRET` on scheduled
# invocations; the route returns 401 (and NO digest is generated) if this is
# unset. Use a long random string.
CRON_SECRET=
# Absolute site origin used for the CSRF same-origin check in middleware.ts and
# for building absolute deep links. e.g. https://snkrfeature.com
NEXT_PUBLIC_APP_URL=
# owner/repo used by /api/download/android to resolve the latest APK release.
GITHUB_REPO=
# Shared Apple demo account surfaced on the /download page (App Store review /
# TestFlight access). Leave blank to hide that panel.
SHARED_APPLE_EMAIL=
SHARED_APPLE_PASSWORD=
